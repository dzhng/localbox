<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.localbox.hostd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Localbox.app/Contents/MacOS/localbox-hostd</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LOCALBOX_IPC_TOKEN_PATH</key><string>~/Library/Application Support/Localbox/ipc-token</string>
    <key>LOCALBOX_SOCKET</key><string>~/Library/Application Support/Localbox/agent.sock</string>
    <key>LOCALBOX_SANDBOXES</key><string>~/Library/Application Support/Localbox/sandboxes</string>
    <key>LOCALBOX_KERNEL</key><string>/Applications/Localbox.app/Contents/Resources/vm/vmlinuz</string>
    <key>LOCALBOX_INITRD</key><string>/Applications/Localbox.app/Contents/Resources/vm/initrd</string>
    <key>LOCALBOX_TEMPLATE_DISK</key><string>/Applications/Localbox.app/Contents/Resources/vm/template.img</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- SIGTERM hibernates every running sandbox before exit; launchd SIGKILLs after this many seconds. -->
  <key>ExitTimeOut</key><integer>60</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>LimitLoadToSessionType</key><array><string>Aqua</string></array>
  <key>StandardOutPath</key><string>~/Library/Logs/Localbox/hostd.log</string>
  <key>StandardErrorPath</key><string>~/Library/Logs/Localbox/hostd.error.log</string>
</dict>
</plist>
