<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.localbox.connector</string>
  <key>ProgramArguments</key>
  <array><string>/Users/USER/.local/bin/localbox</string><string>connector</string><string>run</string></array>
  <key>EnvironmentVariables</key>
  <dict></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>~/Library/Logs/Localbox/connector.log</string>
  <key>StandardErrorPath</key><string>~/Library/Logs/Localbox/connector.log</string>
</dict>
</plist>
