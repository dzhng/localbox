{
  "name": "localbox",
  "private": true,
  "version": "0.1.1",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:workspaces": "turbo run build",
    "test": "tsx --test tests/**/*.test.ts",
    "test:workspaces": "turbo run test",
    "contract:probe": "tsx apps/cli/src/index.ts contract probe",
    "generate:snapshots": "tsx apps/cli/src/index.ts contract generate-snapshots",
    "dev:local": "tsx scripts/local-vercel.ts",
    "proof": "tsx scripts/proof/run.ts",
    "image:build": "tsx packages/vm-image/scripts/build-boot-artifacts.ts --profile full",
    "image:boot": "tsx packages/vm-image/scripts/build-boot-artifacts.ts",
    "image:parity": "tsx packages/vm-image/scripts/duet-parity.ts",
    "release": "sh scripts/release.sh",
    "update": "tsx apps/cli/src/index.ts update",
    "site:build": "npm --prefix apps/site run build",
    "site:test": "npm --prefix apps/site test"
  },
  "bin": {
    "localbox": "bin/localbox.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "convex-test": "^0.0.54",
    "tsx": "^4.19.2",
    "turbo": "^2.11.8",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "convex": "^1.42.1",
    "skills": "1.7.0",
    "undici": "^6.29.0"
  }
}
