#!/bin/sh
set -eu

# The immutable image owns the complete loopback desktop stack. The guest
# service stays on stdin/stdout (virtio-serial in production); X/Chromium/VNC
# are background processes with no public listeners.
export DISPLAY="${DISPLAY:-:0}"
export HOME="${HOME:-/root}"
export LOCALBOX_DESKTOP_BACKEND="${LOCALBOX_DESKTOP_BACKEND:-production}"
export LOCALBOX_CDP_URL="${LOCALBOX_CDP_URL:-http://127.0.0.1:9222}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
mkdir -p "$XDG_RUNTIME_DIR" /var/lib/agent-computer/chromium
chmod 700 "$XDG_RUNTIME_DIR"

children=""
stop_children() {
  for pid in $children; do kill "$pid" 2>/dev/null || true; done
}
trap stop_children EXIT INT TERM

Xvfb "$DISPLAY" -screen 0 1440x900x24 -nolisten tcp >/var/log/agent-computer-xvfb.log 2>&1 &
children="$children $!"
for _ in $(seq 1 50); do
  xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 && break
  sleep 0.1
done

dbus-launch --exit-with-session startxfce4 >/var/log/agent-computer-xfce.log 2>&1 &
children="$children $!"
x11vnc -display "$DISPLAY" -localhost -rfbport 5900 -nopw -forever -shared >/var/log/agent-computer-vnc.log 2>&1 &
children="$children $!"
chromium --class=duet-browser --no-sandbox --disable-dev-shm-usage \
  --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 \
  --user-data-dir=/var/lib/agent-computer/chromium about:blank \
  >/var/log/agent-computer-chromium.log 2>&1 &
children="$children $!"

desktop_ready=0
for _ in $(seq 1 100); do
  if curl -fsS "$LOCALBOX_CDP_URL/json/version" >/dev/null 2>&1 \
    && xdotool getdisplaygeometry >/dev/null 2>&1; then
    desktop_ready=1
    break
  fi
  sleep 0.1
done
[ "$desktop_ready" = 1 ] || { echo "desktop services did not become ready" >&2; exit 1; }

node /opt/agent-computer/dist/apps/guest-agent/src/index.js
