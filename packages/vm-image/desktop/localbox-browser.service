[Unit]
Description=Localbox browser on :0 (CDP on 127.0.0.1:9222)
After=localbox-display.service
BindsTo=localbox-display.service

[Service]
User=exedev
Environment=HOME=/home/exedev DISPLAY=:0
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X0 ]; do sleep 0.1; done'
ExecStart=/usr/bin/google-chrome-stable --remote-debugging-port=9222 --user-data-dir=/home/exedev/.config/localbox-browser --no-first-run --no-default-browser-check --password-store=basic --start-maximized about:blank
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
