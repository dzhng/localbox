[Unit]
Description=Localbox XFCE session on :0
After=localbox-display.service
BindsTo=localbox-display.service

[Service]
User=exedev
Environment=HOME=/home/exedev DISPLAY=:0
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X0 ]; do sleep 0.1; done'
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/startxfce4
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
