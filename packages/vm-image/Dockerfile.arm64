# syntax=docker/dockerfile:1.7
# Localbox ARM64 boot image. The full profile mirrors Duet commit
# 8f3cb100e016e2627618718675b2617d8b98f2aa; see duet-reference/Dockerfile.
ARG BASE_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
FROM ${BASE_IMAGE}
ARG PROFILE=full
ARG BUN_VERSION=1.3.14
ARG BUN_SHA256=a27ffb63a8310375836e0d6f668ae17fa8d8d18b88c37c821c65331973a19a3b
ARG STATIC_WEB_SERVER_VERSION=2.43.0
ARG STATIC_WEB_SERVER_SHA256=6aeca9e23580a187c043daef9c6bf8c12b80bb8d75ed84a23beead2cd193a20d
ARG KASMVNC_VERSION=1.5.0
ARG KASMVNC_SHA256=c9199cf4753208bfb69fd016a9780242bebfc43370cc38c97d61e90a3c783e04
ARG IMAGE_BUILD_VERSION=dev
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LOCALBOX_IMAGE_VERSION=${IMAGE_BUILD_VERSION}

RUN test "$PROFILE" = minimal || test "$PROFILE" = full
# The package names in the full branch are the Duet apt inventory. The only
# package substitution is Chromium for Google's x86_64-only Chrome.
RUN apt-get update && \
  if [ "$PROFILE" = full ]; then \
    apt-get install -y --no-install-recommends \
      build-essential ca-certificates catfish cmake curl devilspie2 ffmpeg \
      fonts-inter fonts-noto-color-emoji fonts-noto-core gh ghostscript git \
      imagemagick jq libcairo2 libcups2 libgl1 libreoffice-calc-nogui \
      libreoffice-core-nogui libreoffice-draw-nogui libreoffice-impress-nogui \
      libreoffice-writer-nogui libvips-tools libxinerama1 libxrandr2 libxrender1 \
      ninja-build pandoc plank poppler-utils pulseaudio pulseaudio-utils \
      python-is-python3 qpdf ripgrep tesseract-ocr thunar unzip vim wget \
      x11-utils xclip xfce4-panel xfce4-session xfce4-settings xfce4-terminal \
      xfdesktop4 xfwm4 dbus-x11 openssl xz-utils zip chromium \
      systemd systemd-sysv systemd-resolved linux-image-generic initramfs-tools socat; \
  else \
    apt-get install -y --no-install-recommends \
      ca-certificates curl systemd systemd-sysv systemd-resolved linux-image-generic initramfs-tools socat; \
  fi && rm -rf /var/lib/apt/lists/*

# NodeSource is shared by both profiles; Ubuntu's Node 18 package is not the
# contract. This is the Node 24 channel used by Duet.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/* \
  && node --version | grep '^v24\.'

COPY packages/vm-image/requirements-arm64.txt /opt/localbox/requirements-arm64.txt
RUN if [ "$PROFILE" = full ]; then \
      apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
      && python3 -m pip install --break-system-packages --no-cache-dir -r /opt/localbox/requirements-arm64.txt \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# Duet's global npm inventory, retained verbatim for full images.
RUN if [ "$PROFILE" = full ]; then npm install -g eslint firecrawl-cli prettier skills typescript; fi

# ARM64 substitutions for Duet's x86_64 release downloads. KasmVNC ships a
# native noble arm64 package at the same version.
RUN if [ "$PROFILE" = full ]; then \
      curl -fsSL -o /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-aarch64.zip" \
      && echo "$BUN_SHA256  /tmp/bun.zip" | sha256sum -c - \
      && unzip -q /tmp/bun.zip -d /tmp \
      && install -m 0755 /tmp/bun-linux-aarch64/bun /usr/local/bin/bun \
      && ln -s /usr/local/bin/bun /usr/local/bin/bunx \
      && curl -fsSL -o /tmp/static-web-server.tar.gz "https://github.com/static-web-server/static-web-server/releases/download/v${STATIC_WEB_SERVER_VERSION}/static-web-server-v${STATIC_WEB_SERVER_VERSION}-aarch64-unknown-linux-gnu.tar.gz" \
      && echo "$STATIC_WEB_SERVER_SHA256  /tmp/static-web-server.tar.gz" | sha256sum -c - \
      && tar -xzf /tmp/static-web-server.tar.gz -C /tmp \
      && install -m 0755 "/tmp/static-web-server-v${STATIC_WEB_SERVER_VERSION}-aarch64-unknown-linux-gnu/static-web-server" /usr/local/bin/static-web-server \
      && curl -fsSL -o /tmp/kasmvncserver.deb "https://github.com/kasmtech/KasmVNC/releases/download/v${KASMVNC_VERSION}/kasmvncserver_noble_${KASMVNC_VERSION}_arm64.deb" \
      && echo "$KASMVNC_SHA256  /tmp/kasmvncserver.deb" | sha256sum -c - \
      && apt-get update && apt-get install -y --no-install-recommends /tmp/kasmvncserver.deb \
      && rm -rf /var/lib/apt/lists/* /tmp/bun.zip /tmp/bun-linux-aarch64 /tmp/static-web-server.tar.gz /tmp/static-web-server-v${STATIC_WEB_SERVER_VERSION}-aarch64-unknown-linux-gnu /tmp/kasmvncserver.deb; \
    fi

# Duet's XFCE/KasmVNC configuration is copied for the full desktop. Branding,
# gateway, Syncthing, and Duet runtime units are deliberately omitted.
RUN if [ "$PROFILE" = full ]; then useradd --create-home --shell /bin/bash exedev; fi
COPY packages/vm-image/duet-reference/desktop/ /opt/localbox/duet-desktop/
RUN if [ "$PROFILE" = full ]; then \
      install -d -m 0755 /home/exedev/.config/xfce4/xfconf/xfce-perchannel-xml /home/exedev/.config/autostart /home/exedev/.config/devilspie2 /home/exedev/.config/plank/dock1/launchers /home/exedev/.vnc/pki /usr/share/backgrounds; \
      cp /opt/localbox/duet-desktop/xfce4/*.xml /home/exedev/.config/xfce4/xfconf/xfce-perchannel-xml/; \
      cp /opt/localbox/duet-desktop/autostart/* /home/exedev/.config/autostart/; \
      cp /opt/localbox/duet-desktop/devilspie2/* /home/exedev/.config/devilspie2/; \
      cp /opt/localbox/duet-desktop/plank/* /home/exedev/.config/plank/dock1/launchers/; \
      cp /opt/localbox/duet-desktop/kasmvnc.yaml /home/exedev/.vnc/kasmvnc.yaml; \
      cp /opt/localbox/duet-desktop/duet-wallpaper.svg /usr/share/backgrounds/duet-wallpaper.svg; \
      chown -R exedev:exedev /home/exedev; \
    fi

# Boot layer: the guest agent on vsock port 1024, DHCP on the NAT interface
# (systemd-networkd and -resolved); machine-id is intentionally empty so the
# guest agent establishes each sandbox's identity from the host's hello.
COPY dist/ /opt/localbox/dist/
RUN install -d -m 0755 /run/localbox /var/lib/localbox \
  && install -d -m 0755 /etc/systemd/system \
  && printf '[Unit]\nDescription=Localbox guest agent on vsock port 1024\n\n[Service]\nType=simple\nExecStart=/usr/bin/socat VSOCK-LISTEN:1024,reuseaddr EXEC:\042/usr/bin/node /opt/localbox/dist/apps/guest-agent/src/index.js\042\nStandardOutput=journal+console\nStandardError=journal+console\nRestart=always\nRestartSec=0\nEnvironment=LOCALBOX_ROOT=/\nEnvironment=LOCALBOX_READINESS_MARKER=/run/localbox/ready\n\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/localbox-guest.service \
  && systemctl enable localbox-guest.service \
  && printf '[Match]\nName=en*\n\n[Network]\nDHCP=yes\n' > /etc/systemd/network/20-nat.network \
  && systemctl enable systemd-networkd.service systemd-resolved.service \
  && printf '%s' 'virtio_pci\nvirtio_blk\nvirtio_console\next4\n' > /etc/initramfs-tools/modules \
  && update-initramfs -c -k all \
  && : > /etc/machine-id && rm -f /var/lib/dbus/machine-id

CMD ["/sbin/init"]
