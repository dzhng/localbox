# syntax=docker/dockerfile:1.7
# The builder supplies BASE_IMAGE as an immutable digest. Keeping the ARG
# mandatory prevents an accidental moving-tag release.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG DEBIAN_SNAPSHOT=20250929T000000Z
ARG IMAGE_BUILD_VERSION=dev
ARG BUN_VERSION
ARG BUN_SHA256
ARG STATIC_WEB_SERVER_VERSION
ARG STATIC_WEB_SERVER_SHA256
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    AGENT_COMPUTER_IMAGE_VERSION=${IMAGE_BUILD_VERSION} \
    AGENT_COMPUTER_LOOPBACK_BINDINGS=127.0.0.1:9222,127.0.0.1:5900

RUN test "$(dpkg --print-architecture)" = arm64 \
  && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s bookworm main\n' "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list \
  && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/%s bookworm-security main\n' "$DEBIAN_SNAPSHOT" >> /etc/apt/sources.list \
  && apt-get -o Acquire::Check-Valid-Until=false update \
  && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git gh imagemagick ffmpeg ghostscript jq \
    libreoffice-core-nogui pandoc poppler-utils python3 python3-pip qpdf \
    tesseract-ocr libvips-tools nodejs chromium python-is-python3 unzip \
  && rm -rf /var/lib/apt/lists/*

RUN test -n "$BUN_VERSION" -a -n "$BUN_SHA256" -a -n "$STATIC_WEB_SERVER_VERSION" -a -n "$STATIC_WEB_SERVER_SHA256" \
  && curl -fsSL -o /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-aarch64.zip" \
  && echo "$BUN_SHA256  /tmp/bun.zip" | sha256sum -c - \
  && unzip -q /tmp/bun.zip -d /opt \
  && install -m 0755 /opt/bun-linux-aarch64/bun /usr/local/bin/bun \
  && ln -s /usr/local/bin/bun /usr/local/bin/bunx \
  && curl -fsSL -o /tmp/static-web-server.tar.gz "https://github.com/static-web-server/static-web-server/releases/download/v${STATIC_WEB_SERVER_VERSION}/static-web-server-v${STATIC_WEB_SERVER_VERSION}-aarch64-unknown-linux-gnu.tar.gz" \
  && echo "$STATIC_WEB_SERVER_SHA256  /tmp/static-web-server.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/static-web-server.tar.gz -C /tmp \
  && install -m 0755 "/tmp/static-web-server-v${STATIC_WEB_SERVER_VERSION}-aarch64-unknown-linux-gnu/static-web-server" /usr/local/bin/static-web-server \
  && rm -rf /tmp/bun.zip /tmp/static-web-server.tar.gz /opt/bun-linux-aarch64 /tmp/static-web-server-v${STATIC_WEB_SERVER_VERSION}-aarch64-unknown-linux-gnu \
  && bun --version && static-web-server --version

COPY packages/vm-image/requirements-arm64.txt /opt/agent-computer/requirements-arm64.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      --requirement /opt/agent-computer/requirements-arm64.txt

# The guest service and readiness marker are installed into the immutable image
# so the VM starts with the framed service on its virtio-serial stdin/stdout.
COPY packages/vm-image/image-root/ /opt/agent-computer/image-root/
COPY dist/ /opt/agent-computer/dist/
COPY package.json /opt/agent-computer/package.json
RUN install -d -m 0755 /run/agent-computer /var/lib/agent-computer \
  && install -m 0755 /opt/agent-computer/image-root/usr/local/bin/agent-computer-image-probe /usr/local/bin/agent-computer-image-probe \
  && install -m 0755 /opt/agent-computer/image-root/usr/local/bin/duet-browser /usr/local/bin/duet-browser

# The guest service owns stdin/stdout (virtio-serial in production). The image
# probe remains available as a diagnostic command and as the verifier override.
ENTRYPOINT ["node", "/opt/agent-computer/dist/apps/guest-agent/src/index.js"]
