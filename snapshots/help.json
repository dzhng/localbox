  {
    "id": "sandbox.create",
    "description": "Create a sandbox on the machine the request names, else by `placement` (auto takes the online machine with the most room, remote the same without the caller's), else on the caller's own machine; reports where and why, its name and size. It sleeps after `sleep_after_ms` with no request and no running job (default 5 min) and, only when `delete_after_ms` is given, is deleted after that much idle time. Its disk starts from `image` (a name or id), else the account's default image (initially `linux`). A machine without that image gets it copied first: the create answers at once with the sandbox `copying`, every other operation on it answers sandbox_not_ready with the copy's progress, and image.wait follows the copy until the sandbox is created. `after_copy` is set by the agent API (the copy the machine waits for); callers leave it out.",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "type": "string",
          "enum": [
            "auto",
            "remote"
          ]
        },
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1073741824
        },
        "sleep_after_ms": {
          "type": "integer",
          "minimum": 1000
        },
        "delete_after_ms": {
          "type": "integer",
          "minimum": 1000
        },
        "after_copy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "retryable": false,
    "mutation": true,
    "idempotency": "required",
    "executor": "account",
    "sandbox_scoped": false,
    "routing": "machine"
  },
